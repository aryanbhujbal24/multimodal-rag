# Google AI Studio key (free tier): https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Models
GEN_MODEL=gemini-2.0-flash
EMBED_MODEL=text-embedding-004

# "gemini" for real use, "hashing" to run entirely offline with no key
EMBEDDER=gemini

# Retrieval / chunking
CHUNK_SIZE=900
CHUNK_OVERLAP=150
TOP_K=5
TOP_K_FIGURES=2
USE_HYBRID=true
